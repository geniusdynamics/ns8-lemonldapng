import json
import sys
import agent
import agent.tasks
import os

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

# Setup default values
host = data.get("host")
h2hs = data.get("http2https", os.getenv("TRAEFIK_HTTP2HTTPS", "True").lower() == "true")
le = data.get("lets_encrypt", os.getenv("TRAEFIK_LETS_ENCRYPT", "").lower() == "true")
traefik = agent.resolve_agent_id("traefik@node")
agent.assert_exp(traefik is not None, "Traefik is required on this NS8 node.")
module = os.environ["MODULE_ID"]
for prefix in ("", "auth", "manager", "reload", "test1", "test2"):
    instance = f"{prefix}-{module}" if prefix else module
    route_host = f"{prefix}.{host}" if prefix else host
    response = agent.tasks.run(
        agent_id=traefik,
        action="set-route",
        data={
            "instance": instance,
            "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
            "host": route_host,
            "http2https": h2hs,
            "lets_encrypt": le,
        },
    )
    agent.assert_exp(response["exit_code"] == 0, f"Unable to configure the route for {route_host}.")

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
agent.set_env("TRAEFIK_LETS_ENCRYPT", le)
agent.dump_env()

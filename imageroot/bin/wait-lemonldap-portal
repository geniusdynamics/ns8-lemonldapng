set -eu
for attempt in {1..20}; do
    if curl --silent --fail --max-time 2 --output /dev/null \
        --header "Host: auth.${TRAEFIK_HOST}" "http://127.0.0.1:${TCP_PORT}/"; then
        exit 0
    fi
    sleep 1
done
echo "LemonLDAP::NG portal did not become ready" >&2
exit 1

import os
import subprocess
from urllib.parse import urlsplit, urlunsplit

cli = ["podman", "exec", "lemonldapng-app",
       "/usr/share/lemonldap-ng/bin/lemonldap-ng-cli", "-yes", "1"]
cda = os.environ.get("CDA_STATUS", "").lower() == "true"
portal = subprocess.check_output([*cli, "get", "portal"], text=True).strip()
url = urlsplit(portal.removeprefix("portal = "))
if not url.hostname:
    url = urlsplit(f"http://auth.{os.environ['TRAEFIK_HOST']}/")
secure = cda or url.scheme == "https" or any(
    os.environ.get(name, "").lower() == "true"
    for name in ("TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT")
)
portal_url = urlunsplit(url._replace(scheme="https" if secure else "http"))
subprocess.run([*cli, "set", "cda", str(int(cda)), "securedCookie", str(int(secure)),
                "portal", portal_url], check=True, stdout=subprocess.DEVNULL)
